# Canonical origin. Keep www unless the DNS setup changes.
NEXT_PUBLIC_SITE_URL=https://www.blackcoffeeatl.com

# Private-hire inquiries are emailed through Resend (https://resend.com).
RESEND_API_KEY=
INQUIRY_TO=westside@blackcoffeeatl.com
# Must be an address on a domain verified in Resend, e.g. after adding blackcoffeeatl.com there.
INQUIRY_FROM="Black Coffee ATL website <inquiries@blackcoffeeatl.com>"

# Optional: privacy-light analytics. Set to the site domain to load Plausible.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Optional: a referrer-restricted Google Maps Static API key for the Visit map image.
NEXT_PUBLIC_GOOGLE_MAPS_STATIC_KEY=

# Search Console and Bing Webmaster verification tokens.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Set to 1 on any staging or test server so it is never indexed. Vercel previews are handled automatically.
NEXT_PUBLIC_NOINDEX=
